{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(rtk ls *)",
      "Bash(rtk find *)",
      "Bash(uv run *)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(snow --version)",
      "Bash(git config *)",
      "Bash(uv --version)",
      "Bash(uv python *)",
      "Bash(npm -v)",
      "Bash(npm config *)",
      "Bash(git --version)",
      "Bash(rtk git *)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ],
    "ask": [
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(bash script/databricks/02_upload_files.sh:*)",
      "Bash(bash script/snowflake/02_upload_files.sh:*)",
      "Bash(bash script/databricks/generated/*)",
      "Bash(bash script/snowflake/generated/*)",
      "Bash(databricks:*)",
      "Bash(snowsql:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ruff-format.js"
          }
        ]
      }
    ]
  }
}
