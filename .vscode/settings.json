{
    // --- Cells (Databricks + standard "# %%") ---
    "jupyter.interactiveWindow.cellMarker.codeRegex": "^# COMMAND ----------|^# Databricks notebook source|^(#\\s*%%|#\\s*\\<codecell\\>|#\\s*In\\[\\d*?\\]|#\\s*In\\[ \\])",
    "jupyter.interactiveWindow.cellMarker.default": "# %%",

    // --- Visual identity (purple) ---
    "workbench.colorCustomizations": {
        "activityBar.background": "#5B3A9E",
        "activityBar.foreground": "#ffffff",
        "activityBar.inactiveForeground": "#ffffff99",
        "titleBar.activeBackground": "#5B3A9E",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#5B3A9E",
        "titleBar.inactiveForeground": "#ffffff99"
    },

    // --- Python ---
    // "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": false,
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["tests"],

    // --- Format / lint (Ruff replaces black, isort, flake8) ---
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "notebook.formatOnSave.enabled": true,
    "[json][jsonc][yaml][markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // --- Notebooks ---
    "notebook.diff.ignoreOutputs": true,
    "notebook.output.textLineLimit": 50,
    "jupyter.askForKernelRestart": false,
    "jupyter.interactiveWindow.textEditor.executeSelection": true,

    // --- File hygiene ---
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "editor.rulers": [88],
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.ipynb_checkpoints": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/*.lock": true
    },
    "git.autofetch": true,
    // --- Line endings ---
    "files.eol": "\n",

    // --- Copilot: commit messages ---
    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "text": "Write the commit message following the Conventional Commits specification: <type>(<optional scope>): <description>. Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore. Description in the imperative mood, lowercase, no trailing period, 72 characters maximum. Add a body only if necessary, separated by a blank line. Write in English."
        }
    ]
}
